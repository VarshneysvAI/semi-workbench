# --- SEMI backend environment ---
# Copy to backend/.env and fill in. NEVER commit the real .env.

# FastAPI
APP_NAME=SEMI Workbench
APP_VERSION=0.2.0
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- PRIMARY LLM: Gemini free tier serves the Gemma model (google.genai) ----
# User decision: NVIDIA NIM was too slow; the Gemma model runs on the free-tier
# Google AI Studio key instead. Strict-JSON single-field extraction ~3s.
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemma-4-31b-it

# ---- OPTIONAL LLM channel B: NVIDIA NIM (OpenAI-compatible) ----
# Kept env-driven for flexibility; not used unless GOOGLE_API_KEY is absent.
LLM_BASE_URL_NIM=https://integrate.api.nvidia.com/v1
LLM_API_KEY_NIM=
LLM_MODEL_NIM=google/gemma-4-31b-it

# ---- Discovery: hybrid chain, strict priority (first backend with hits wins) ----
# 1. agent-reach  (CLI; auto-detected on PATH or set AGENTREACH_CMD explicitly)
# 2. Firecrawl    (FIRECRAWL_API_KEY)
# 3. Exa          (EXA_API_KEY)
# 4. ddgs         (DuckDuckGo, no key) — always-on last resort
AGENTREACH_ENABLED=true
AGENTREACH_CMD=
YTDLP_CMD=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
EXA_API_KEY=
DDGS_MAX_RESULTS=8

# ---- Retrieval / precedent (Day 9-10) ----
PRETRIEVAL_THRESHOLD=0.85

# ---- Fetch / extract content per source (content-type routed) ----
JINA_READER_BASE_URL=https://r.jina.ai

# ---- Optional telemetry ----
SENTRY_DSN=
