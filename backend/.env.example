# --- SEMI backend environment ---
# Copy to backend/.env and fill in. NEVER commit the real .env.

# FastAPI
APP_NAME=SEMI Workbench
APP_VERSION=0.2.0
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- PRIMARY LLM: Google AI Studio native SDK (genai) ----
# Verified live: gemma-4-31b-it on a Google AI Studio key; strict-JSON single-field
# extraction ~3s. gemini-2.5-flash is a faster secondary when low latency matters.
# Used by backend/llm/gemma.py (extract_field + classify_json).
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemma-4-31b-it

# ---- OPTIONAL LLM channel B: NVIDIA NIM (OpenAI-compatible) ----
# Listed because the user has NIM access too, but the free tier cold-starts
# past our demo budget; kept env-driven, not active by default.
LLM_BASE_URL_NIM=https://integrate.api.nvidia.com/v1
LLM_API_KEY_NIM=
LLM_MODEL_NIM=google/gemma-4-31b-it

# ---- Discovery: live web search ----
# No key required — ddgs (DuckDuckGo) is the non-static default backend.
DDGS_MAX_RESULTS=8
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
AGENTREACH_ENABLED=false

# ---- Fetch / extract content per source (content-type routed) ----
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
JINA_READER_BASE_URL=https://r.jina.ai

# ---- Retrieval / precedent (Day 9-10) ----
PRETRIEVAL_THRESHOLD=0.85

# ---- Optional telemetry ----
SENTRY_DSN=
