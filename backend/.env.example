# --- SEMI backend environment ---
# Copy to backend/.env and fill in. NEVER commit the real .env.

# FastAPI
APP_NAME=SEMI Workbench
APP_VERSION=0.2.0
# 0.0.0.0 for Render, 127.0.0.1 for local dev
HOST=127.0.0.1
PORT=8000
# CORS: comma-separated list, * for dev only
CORS_ORIGINS=http://localhost:5173

# ---- LLM extraction (Day 4–5) ----
# OpenAI-compatible endpoint for the Gemma model fallback.
# Examples:
#   Groq:        https://api.groq.com/openai/v1   model=gemma-3-27b-it
#   Google AI:   https://generativelanguage.googleapis.com/v1beta/openai
#   Local Ollama:http://localhost:11434/v1        model=gemma3:12b
# Set temperature=0.0 for deterministic single-field extraction only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma-3-12b-it
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# ---- Retrieval / precedent (Day 9–10) ----
# Cosine similarity threshold for "precedent match" against the resolution ledger.
# A higher value is stricter (fewer matches, less risk of leakage).
PRETRIEVAL_THRESHOLD=0.85

# ---- Optional telemetry (left blank for hackathon) ----
SENTRY_DSN=
